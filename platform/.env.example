# Copier en .env (jamais commité) et adapter.
# Seules les variables utilisées par le code actuel figurent ici ; la liste cible est
# dans ARCHITECTURE.md §16.3 et s'enrichira à chaque étape.

APP_ENV=local
LOG_LEVEL=INFO

# Driver asyncpg obligatoire. Correspond au service postgres de docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://digital360:digital360@localhost:5432/digital360

# Origines du frontend autorisées à appeler l'API avec cookies (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
